generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  ORGANIZATOR
  TURNIKET
}

enum EventFormat {
  OFFLINE
  ONLINE
  HYBRID
}

enum EventStatus {
  FINISHED
  PUBLISHED
  PRIVATE
}

enum TagType {
  SYSTEM
  CUSTOM
}

enum TeamFormat {
  OFFLINE
  ONLINE
}

enum StatusJoinRequest {
  PENDING
  ACCEPT
  REJECTED
  CANCELED
}

enum EventEntryDecisionCode {
  ALLOW
  DENY_EXPIRED
  DENY_REPLAY
  DENY_INVALID
  DENY_NOT_ELIGIBLE
}

model User {
  idUser String @id @default(cuid()) @map("id_user")

  email   String  @unique
  phone   String? @unique
  contact String? @unique

  password String

  surname    String?
  name       String?
  patronymic String?
  birthDate  DateTime? @map("birth_date")
  city       String?

  verificationToken String? @default(cuid()) @map("verification_token")

  otpCode      String?   @map("otp_code")
  otpExpiresAt DateTime? @map("otp_expires_at")

  isTwoFactorEnabled Boolean @default(false) @map("is_two_factor_enabled")

  role Role @default(USER)

  organizations      UserOrganization[]
  ownedOrganizations Organization[]     @relation("OrganizationOwner")

  event        Event[]
  team         UserTeam[]
  captionTeams Team[]     @relation("TeamCaption")

  tags                    Tag[]
  teamJoinRequest         TeamJoinRequest[]
  eventJoinRequest        EventJoinRequest[]
  organizationJoinRequest OrganizationJoinRequest[]
  solutions               Solution[]
  results                 Result[]
  eventParticipant        UserEvent[]
  eventAdminAccess        EventAdminAccess[]
  eventEntries            EventEntryLog[] @relation("EventEntryParticipant")
  scannedEntries          EventEntryLog[] @relation("EventEntryTurniket")
  eventTurnikets          EventTurniket[] @relation("EventTurniketUser")
  createdEventTurnikets   EventTurniket[] @relation("EventTurniketCreator")

  @@map("users")
}

model UserOrganization {
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [idUser], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [idOrganization], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("user_organization")
}

model Organization {
  idOrganization String @id @default(cuid()) @map("id_organization")

  name        String
  description String?
  address     String?
  cordinatY   Float?
  cordinatX   Float?

  ownerUserId String @map("owner_user_id")
  owner       User   @relation("OrganizationOwner", fields: [ownerUserId], references: [idUser])

  users       UserOrganization[]
  events      Event[]
  joinRequest OrganizationJoinRequest[]

  @@map("organizations")
}

model OrganizationJoinRequest {
  idJoinTeam String @id @default(cuid()) @map("id_join_organization")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [idOrganization])
  userId         String
  user           User         @relation(fields: [userId], references: [idUser])

  status StatusJoinRequest @default(PENDING)

  @@unique([userId, organizationId])
  @@map("organization_join_request")
}

model Event {
  idEvent String @id @default(cuid()) @map("id_event")

  title       String
  description String?
  slug        String
  type        String

  address   String
  cordinatY Float?
  cordinatX Float?

  dataStartRegistration DateTime?
  dataEndRegistration   DateTime?
  dataStart             DateTime
  dataEnd               DateTime
  dateDeadLine          DateTime?

  format EventFormat
  status EventStatus @default(PUBLISHED)

  hasCases            Boolean @default(false) @map("has_cases")
  hasTeams            Boolean @default(false) @map("has_teams")
  hasParticipantLimit Boolean @default(false) @map("has_participant_limit")
  hasLoadedSolution   Boolean @default(false) @map("has_loaded_solution")
  hasMaterials        Boolean @default(false) @map("has_materials")
  hasResualt          Boolean @default(false) @map("has_resualt")
  hasEntryPass        Boolean @default(false) @map("has_entry_pass")

  participantLimit      Int? @map("participant_limit")
  participanInTeamLimit Int? @map("participan_in_team_limit")

  cases     Case[]
  teams     Team[]
  materials Material[]
  solutions Solution[]
  results   Result[]

  organizationId String             @map("organization_id")
  organization   Organization       @relation(fields: [organizationId], references: [idOrganization])
  userId         String             @map("user_id")
  user           User               @relation(fields: [userId], references: [idUser])
  tag            EventTag[]
  participant    UserEvent[]
  joinRequest    EventJoinRequest[]
  adminAccess    EventAdminAccess[]
  entryLogs      EventEntryLog[]
  turnikets      EventTurniket[]

  @@unique([slug])
  @@map("events")
}

model EventTurniket {
  idTurniket String @id @default(cuid()) @map("id_turniket")

  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [idEvent], onDelete: Cascade)

  userId String @unique @map("user_id")
  user   User   @relation("EventTurniketUser", fields: [userId], references: [idUser], onDelete: Cascade)

  label String

  isActive Boolean @default(true) @map("is_active")

  createdByAdminId String @map("created_by_admin_id")
  createdByAdmin   User   @relation("EventTurniketCreator", fields: [createdByAdminId], references: [idUser], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([eventId, label])
  @@unique([eventId, userId])
  @@map("event_turnikets")
}

model EventAdminAccess {
  idAccess String @id @default(cuid()) @map("id_access")

  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [idEvent], onDelete: Cascade)
  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [idUser], onDelete: Cascade)

  canView                 Boolean @default(true) @map("can_view")
  canEditGeneral          Boolean @default(false) @map("can_edit_general")
  canEditSettings         Boolean @default(false) @map("can_edit_settings")
  canEditMaterials        Boolean @default(false) @map("can_edit_materials")
  canEditCases            Boolean @default(false) @map("can_edit_cases")
  canViewParticipants     Boolean @default(false) @map("can_view_participants")
  canViewTeams            Boolean @default(false) @map("can_view_teams")
  canViewSolutions        Boolean @default(false) @map("can_view_solutions")
  canViewResults          Boolean @default(false) @map("can_view_results")
  canEditResults          Boolean @default(false) @map("can_edit_results")
  canDeleteResults        Boolean @default(false) @map("can_delete_results")
  canFinishEvent          Boolean @default(false) @map("can_finish_event")
  canExportCsv            Boolean @default(false) @map("can_export_csv")
  canManagePrivateInvites Boolean @default(false) @map("can_manage_private_invites")
  canViewTurniketStats    Boolean @default(false) @map("can_view_turniket_stats")
  canManageTurnikets      Boolean @default(false) @map("can_manage_turnikets")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([eventId, userId])
  @@map("event_admin_access")
}

model UserEvent {
  eventId String  @map("event_id")
  event   Event   @relation(fields: [eventId], references: [idEvent], onDelete: Cascade)
  userId  String  @map("user_id")
  user    User    @relation(fields: [userId], references: [idUser], onDelete: Cascade)
  caseId  String? @map("case_id")
  case    Case?   @relation(fields: [caseId], references: [idCase])

  createAt DateTime @default(now()) @map("create_at")

  @@unique([eventId, userId])
  @@map("user_event")
}

model EventTag {
  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [idEvent], onDelete: Cascade)
  tagId   String @map("tag_id")
  tag     Tag    @relation(fields: [tagId], references: [idTag], onDelete: Cascade)

  @@unique([eventId, tagId])
  @@map("event_tag")
}

model Tag {
  idTag String @id @default(cuid()) @map("id_tag")

  name String
  slug String
  type TagType

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [idUser])

  event EventTag[]
  cases CaseTag[]

  @@unique([slug, userId])
  @@map("tags")
}

model Case {
  idCase String @id @default(cuid()) @map("id_case")

  title       String
  description String?
  holder      String?
  teamLimit   Int?
  isOpen      Boolean @default(false)

  dateForStartSelected DateTime
  dateForEndSelected   DateTime
  dateStopCode         DateTime

  eventId   String      @map("event_id")
  event     Event       @relation(fields: [eventId], references: [idEvent], onDelete: Cascade)
  materials Material[]
  teams     Team[]
  solutions Solution[]
  results   Result[]
  tag       CaseTag[]
  userEvent UserEvent[]
  entryLogs EventEntryLog[]

  @@map("cases")
}

model CaseTag {
  caseId String @map("case_id")
  case   Case   @relation(fields: [caseId], references: [idCase], onDelete: Cascade)
  tagId  String @map("tag_id")
  tag    Tag    @relation(fields: [tagId], references: [idTag], onDelete: Cascade)

  @@unique([caseId, tagId])
  @@map("case_tag")
}

model Material {
  idMaterial String @id @default(cuid()) @map("id_material")

  title       String
  description String?
  url         String

  caseId  String? @map("case_id")
  case    Case?   @relation(fields: [caseId], references: [idCase], onDelete: Cascade)
  eventId String  @map("event_id")
  event   Event   @relation(fields: [eventId], references: [idEvent], onDelete: Cascade)

  @@map("materials")
}

model UserTeam {
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [idUser], onDelete: Cascade)
  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [idTeam], onDelete: Cascade)

  role String?

  @@unique([userId, teamId])
  @@map("user_team")
}

model Team {
  idTeam String @id @default(cuid()) @map("id_team")

  name        String
  description String?
  format      TeamFormat

  createAt DateTime @default(now()) @map("create_at")

  captionId String @map("caption_id")
  caption   User   @relation("TeamCaption", fields: [captionId], references: [idUser])

  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [idEvent])

  caseId String? @map("case_id")
  case   Case?   @relation(fields: [caseId], references: [idCase])

  user        UserTeam[]
  joinRequest TeamJoinRequest[]
  solutions   Solution[]
  results     Result[]
  entryLogs   EventEntryLog[]

  @@unique([name, eventId])
  @@map("teams")
}

model TeamJoinRequest {
  idJoinTeam String @id @default(cuid()) @map("id_join_team")

  teamId String
  team   Team   @relation(fields: [teamId], references: [idTeam])
  userId String
  user   User   @relation(fields: [userId], references: [idUser])

  status StatusJoinRequest @default(PENDING)

  @@unique([userId, teamId])
  @@map("team_join_request")
}

model EventJoinRequest {
  idJoinEvent String @id @default(cuid()) @map("id_join_event")

  eventId String
  event   Event  @relation(fields: [eventId], references: [idEvent], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [idUser], onDelete: Cascade)

  status StatusJoinRequest @default(PENDING)

  @@unique([userId, eventId])
  @@map("event_join_request")
}

model Solution {
  idSolution String @id @default(cuid()) @map("id_solution")

  urlSolution     String  @map("url_solution")
  urlPresentation String  @map("url_presentation")
  description     String?

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  eventId String
  event   Event   @relation(fields: [eventId], references: [idEvent])
  caseId  String?
  case    Case?   @relation(fields: [caseId], references: [idCase])
  teamId  String?
  team    Team?   @relation(fields: [teamId], references: [idTeam])
  userId  String?
  user    User?   @relation(fields: [userId], references: [idUser])

  @@unique([eventId, userId])
  @@unique([eventId, teamId])
  @@map("solutions")
}

model Result {
  idResult String @id @default(cuid()) @map("id_result")

  title       String
  place       Int
  description String?
  score       Float?

  eventId String
  event   Event   @relation(fields: [eventId], references: [idEvent])
  caseId  String?
  case    Case?   @relation(fields: [caseId], references: [idCase])
  teamId  String?
  team    Team?   @relation(fields: [teamId], references: [idTeam])
  userId  String?
  user    User?   @relation(fields: [userId], references: [idUser])

  @@unique([eventId, userId])
  @@unique([eventId, teamId])
  @@index([eventId, caseId, place])
  @@map("results")
}

model EventEntryLog {
  idEventEntryLog String @id @default(cuid()) @map("id_event_entry_log")

  eventId                 String?                 @map("event_id")
  event                   Event?                  @relation(fields: [eventId], references: [idEvent], onDelete: SetNull)
  userId                  String?                 @map("user_id")
  user                    User?                   @relation("EventEntryParticipant", fields: [userId], references: [idUser], onDelete: SetNull)
  turniketUserId          String?                 @map("turniket_user_id")
  turniketUser            User?                   @relation("EventEntryTurniket", fields: [turniketUserId], references: [idUser], onDelete: SetNull)
  teamId                  String?                 @map("team_id")
  team                    Team?                   @relation(fields: [teamId], references: [idTeam], onDelete: SetNull)
  caseId                  String?                 @map("case_id")
  case                    Case?                   @relation(fields: [caseId], references: [idCase], onDelete: SetNull)
  scannedAt               DateTime                @default(now()) @map("scanned_at")
  decision                EventEntryDecisionCode
  tokenJti                String?                 @map("token_jti")
  turniketLabelSnapshot   String?                 @map("turniket_label_snapshot")
  userDisplayNameSnapshot String?                 @map("user_display_name_snapshot")
  eventTitleSnapshot      String?                 @map("event_title_snapshot")
  wasFirstSuccessfulEntry Boolean                 @default(false) @map("was_first_successful_entry")
  failureReason           String?                 @map("failure_reason")
  scannerDeviceId         String?                 @map("scanner_device_id")

  @@index([eventId, scannedAt])
  @@index([userId, scannedAt])
  @@index([turniketUserId, scannedAt])
  @@index([decision, scannedAt])
  @@map("event_entry_logs")
}
